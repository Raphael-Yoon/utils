# ==============================================================================
# [개발4팀] CBT 모의고사 엔진 환경 설정 템플릿 (.env.example)
# ==============================================================================
# 사용법: 이 파일을 복사하여 .env 로 이름을 변경한 후 사용하세요.
#   cp .env.example .env

# 1. 운영/개발 환경 구분
# IS_PROD=true  → 운영서버 모드 (MySQL 'cbt' 전용 DB 사용)
# IS_PROD=false → 개발서버 모드 (SQLite 'cbt.db' 사용)
IS_PROD=false

# 2. CBT 전용 MySQL 데이터베이스 연결 정보 (운영 모드 시 사용)
CBT_DATABASE_URL=mysql://root:150606@127.0.0.1:3306/cbt

# 3. CBT 웹 서버 포트
CBT_PORT=8080
